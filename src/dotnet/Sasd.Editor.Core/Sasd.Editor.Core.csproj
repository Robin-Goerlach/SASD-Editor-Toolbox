<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Sasd.Editor.Core</AssemblyName>
    <RootNamespace>Sasd.Editor</RootNamespace>
    <Description>UI-agnostic reusable editor foundation for SASD applications.</Description>
    <PackageId>Sasd.Editor.Core</PackageId>
    <Authors>SASD-GmbH</Authors>
    <RepositoryUrl>https://github.com/Robin-Goerlach/SASD-Editor-Toolbox</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Version is intentionally supplied by the pack command for prerelease
         artifacts. This source baseline is not an approved V1.0 release. -->
    <Version Condition="'$(Version)' == ''">0.0.0-development</Version>
    <PackageTags>editor;text-editing;sasd;headless</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Embed the maintained repository overview in the nupkg so package
         consumers can discover supported scope and limitations offline. -->
    <None Include="../../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
