    {
      "id": "editing.new-line-insert-mode-splits-and-moves-cursor",
      "area": "editing",
      "initial": {
        "documents": [
          {
            "id": "doc-1",
            "lines": [
              {
                "text": "abcd",
                "flags": []
              }
            ]
          }
        ],
        "windows": [
          {
            "id": "win-1",
            "documentId": "doc-1",
            "cursor": {
              "line": 0,
              "column": 2
            },
            "options": {
              "insertMode": true,
              "autoIndent": false
            }
          }
        ],
        "currentWindowId": "win-1"
      },
      "operation": {
        "id": "new_line"
      },
      "expect": {
        "documents": {
          "doc-1": {
            "lines": [
              {
                "text": "ab",
                "flags": []
              },
              {
                "text": "cd",
                "flags": []
              }
            ]
          }
        },
        "windows": {
          "win-1": {
            "cursor": {
              "line": 1,
              "column": 0
            }
          }
        }
      }
    },
    {
