    {
      "id": "blocks.begin-alone-is-incomplete-and-hidden",
      "area": "blocks",
      "initial": {
        "documents": [
          {
            "id": "doc-1",
            "lines": [
              {
                "text": "a",
                "flags": []
              },
              {
                "text": "b",
                "flags": []
              },
              {
                "text": "c",
                "flags": []
              }
            ]
          }
        ],
        "windows": [
          {
            "id": "win-1",
            "documentId": "doc-1",
            "cursor": {
              "line": 1,
              "column": 0
            }
          }
        ],
        "currentWindowId": "win-1"
      },
      "operation": {
        "id": "begin_block"
      },
