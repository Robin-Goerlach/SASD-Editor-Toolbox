{
  "formatVersion": 1,
  "contractVersion": "v1",
  "cases": [
    {
      "id": "editing.move-right-enters-virtual-column",
      "area": "editing",
      "initial": {
        "documents": [
          {
            "id": "doc-1",
            "lines": [
              {
                "text": "abc",
                "flags": []
              }
            ]
          }
        ],
        "windows": [
          {
            "id": "win-1",
            "documentId": "doc-1",
            "cursor": {
              "line": 0,
              "column": 3
            }
          }
        ],
        "currentWindowId": "win-1"
      },
      "operation": {
        "id": "move_right_character"
      },
      "expect": {
        "windows": {
          "win-1": {
            "cursor": {
              "line": 0,
              "column": 4
            }
          }
        }
      }
    },
